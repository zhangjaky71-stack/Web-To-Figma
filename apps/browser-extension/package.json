{
  "name": "@w2f/browser-extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-extension.mjs && tsc -p tsconfig.build.json && node scripts/package-extension.mjs && node scripts/validate-extension-package.mjs",
    "validate:package": "node scripts/validate-extension-package.mjs",
    "lint": "eslint src test scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@w2f/stable-identity": "workspace:*",
    "@w2f/w2f-ir": "workspace:*",
    "@w2f/w2f-schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
