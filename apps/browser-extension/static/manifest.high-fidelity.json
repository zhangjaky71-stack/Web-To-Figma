{
  "manifest_version": 3,
  "name": "Web-To-Figma Capture — High Fidelity",
  "version": "0.1.0",
  "description": "Capture web pages with Chrome DevTools Protocol evidence into portable .wtf documents for reconstruction in Figma.",
  "action": {
    "default_title": "Web-To-Figma Capture — High Fidelity",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the active page for Figma"
    }
  },
  "background": {
    "service_worker": "runtime/service-worker-entry.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "debugger", "downloads"],
  "host_permissions": ["file:///*"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
