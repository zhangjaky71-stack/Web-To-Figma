{
  "name": "@w2f/figma-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-plugin.mjs && node scripts/validate-plugin-package.mjs",
    "validate:package": "node scripts/validate-plugin-package.mjs",
    "lint": "eslint src test scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@w2f/w2f-ir": "workspace:*",
    "@w2f/w2f-parser": "workspace:*",
    "@w2f/w2f-schema": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.134.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
