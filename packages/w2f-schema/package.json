{
  "name": "@w2f/w2f-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/public.ts",
      "default": "./dist/public.js"
    },
    "./container-paths": {
      "types": "./src/container-paths.ts",
      "default": "./dist/container-paths.js"
    },
    "./frame-context": {
      "types": "./src/frame-context.ts",
      "default": "./dist/frame-context.js"
    },
    "./scale-context": {
      "types": "./src/scale-context.ts",
      "default": "./dist/scale-context.js"
    }
  },
  "types": "./src/public.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
